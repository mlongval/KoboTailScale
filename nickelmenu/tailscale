# NickelMenu — Tailscale
# Installed to /mnt/onboard/.adds/nm/tailscale
#
# One toggle plus a status readout. NickelMenu cannot relabel an item based on
# state, so an on/off pair would always show a stale label; toggle + status is
# the honest version.
#
# The toggle brings WiFi up first, because tailscaled without a network is just
# a sulking process. chain_always rather than chain_success: a failed
# autoconnect must not stop you from toggling Tailscale *off*, and tailscaled
# copes fine with the link arriving late.

# Everything runs through /bin/sh rather than relying on the executable bit:
# the user partition is vfat, where that bit is a mount option, not a fact.

menu_item :main :Tailscale        :nickel_wifi :autoconnect
  chain_always                    :cmd_spawn   :quiet:exec /bin/sh /mnt/onboard/.adds/tailscale/tailscale-ctl.sh toggle
  chain_failure                   :dbg_toast   :Tailscale: failed to start (see log)

menu_item :main :Tailscale status :cmd_output  :3000:quiet:/bin/sh /mnt/onboard/.adds/tailscale/tailscale-ctl.sh status
